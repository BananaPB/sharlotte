{
    "model": "sonnet",
    "permissions": {
        "allow": [
            "Bash(git status)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git checkout:*)",
            "Bash(./vendor/bin/pint:*)",
            "Bash(./vendor/bin/pest:*)",
            "Bash(./vendor/bin/phpstan:*)",
            "Bash(npm run lint:*)",
            "Bash(npm run test:*)"
        ],
        "deny": ["Bash(git push --force:*)", "Bash(rm -rf:*)"]
    }
}
