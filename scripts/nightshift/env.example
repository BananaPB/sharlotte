# nightshift configuration — copy to ~/.config/nightshift/env on the machine that runs Hermes,
# then `chmod 600` it: it holds two secrets. Never commit the real file.

# The repository, and where the runner keeps its own clone of main and its state.
REPO_SLUG=BananaPB/sharlotte
REPO_DIR=$HOME/nightshift/sharlotte
STATE_DIR=$HOME/nightshift/state

# The bot account (docs/nightshift.md, step 1): a classic token with the `repo` scope only (no
# `workflow`, no `admin`). The bot is a collaborator on this repo and nothing else, so that's its reach.
GH_TOKEN=ghp_xxx
BOT_NAME=sharlotte-bot
BOT_EMAIL=000000+sharlotte-bot@users.noreply.github.com

# Long-lived token for your Claude subscription: run `claude setup-token` and paste the result.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxx

# Only issues opened by these GitHub logins are ever handed to an agent (space-separated).
TRUSTED_AUTHORS="BananaPB sharlotte-bot"

# Budget for one run.
MAX_FEATURES=3            # at most this many briefs per run
STOP_LAUNCHING_AT=06:00   # no new brief starts after this time (the current one finishes)
FEATURE_TIMEOUT=4h        # hard stop for a single brief
MAX_TURNS=300             # Claude Code --max-turns for a single brief
CLAUDE_MODEL=             # empty = the model from .claude/settings.json

# Optional: the security-audit skill, cloned from github.com/cloudflare/security-audit-skill.
AUDIT_SKILL_DIR=$HOME/nightshift/security-audit-skill/skills/security-audit
